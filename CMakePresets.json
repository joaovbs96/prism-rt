{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "prism-base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "VCPKG_MANIFEST_INSTALL": "OFF"
      }
    },
    {
      "name": "prism-standalone",
      "displayName": "PrismRT standalone",
      "inherits": "prism-base",
      "cacheVariables": {
        "PRISM_BUILD_HYDRA": "OFF",
        "PRISM_COPY_ASSETS": "ON"
      }
    },
    {
      "name": "prism-hydra",
      "displayName": "PrismRT Hydra delegate",
      "inherits": "prism-base",
      "cacheVariables": {
        "PRISM_BUILD_HYDRA": "ON",
        "PRISM_COPY_ASSETS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "prism-standalone",
      "configurePreset": "prism-standalone",
      "configuration": "RelWithDebInfo",
      "jobs": 8,
      "targets": ["PrismRT"]
    },
    {
      "name": "prism-hydra",
      "configurePreset": "prism-hydra",
      "configuration": "RelWithDebInfo",
      "jobs": 8
    }
  ],
