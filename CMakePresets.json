{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "prism-base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "VCPKG_MANIFEST_INSTALL": "OFF",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install"
      }
    },
    {
      "name": "prism-standalone",
      "displayName": "PrismRT standalone",
      "inherits": "prism-base",
      "cacheVariables": {
        "PRISM_BUILD_HYDRA": "OFF",
        "PRISM_COPY_ASSETS": "ON"
      }
    },
    {
      "name": "prism-hydra",
      "displayName": "PrismRT Hydra delegate",
      "inherits": "prism-base",
      "cacheVariables": {
        "PRISM_BUILD_HYDRA": "ON",
        "PRISM_COPY_ASSETS": "OFF"
      }
    },
    {
      "name": "prism-hydra-fresh",
      "displayName": "PrismRT Hydra clean validation",
      "inherits": "prism-hydra",
      "binaryDir": "${sourceDir}/build-fresh-validation"
    }
  ],
  "buildPresets": [
    {
      "name": "prism-standalone",
      "configurePreset": "prism-standalone",
      "configuration": "RelWithDebInfo",
      "jobs": 8,
      "targets": ["PrismRT"]
    },
    {
      "name": "prism-hydra",
      "configurePreset": "prism-hydra",
      "configuration": "RelWithDebInfo",
      "jobs": 8
    },
    {
      "name": "prism-hydra-fresh",
      "configurePreset": "prism-hydra-fresh",
      "configuration": "RelWithDebInfo",
      "jobs": 8
    }
  ],
  "testPresets": [
    {
      "name": "prism-hydra",
      "configurePreset": "prism-hydra",
      "configuration": "RelWithDebInfo",
      "environment": {
        "PXR_PLUGINPATH_NAME": "${sourceDir}/build/hydra/resources",
        "PXR_USD_WINDOWS_DLL_PATH": "$penv{PXR_USD_WINDOWS_DLL_PATH}",
        "PATH": "${sourceDir}/build/hydra/plugin;$penv{PATH}",
        "PRISM_MATERIALX_LIBRARY_PATH": "$penv{PRISM_MATERIALX_LIBRARY_PATH}",
        "PRISM_MATERIALX_MDL": "$penv{PRISM_MATERIALX_MDL}",
        "MDL_SDK_ROOT": "$penv{PRISM_MDL_SDK_ROOT}"
      },
      "output": { "outputOnFailure": true }
    }
  ]
}
