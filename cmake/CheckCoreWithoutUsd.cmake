# prism_core_without_usd_test (PrismCoreWithoutUsd.cmake): the generated build
# settings of the core library hold no pxr include directory and no pxr
# target. Run with cmake -DSETTINGS=<settings.cmake> -P.
cmake_minimum_required(VERSION 3.20)
if(NOT SETTINGS OR NOT EXISTS "${SETTINGS}")
    message(FATAL_ERROR "core build settings not found: ${SETTINGS}")
endif()
include("${SETTINGS}")
set(_failures "")
if(NOT CORE_INCLUDES)
    message(FATAL_ERROR "the core library has no include directories recorded")
endif()
foreach(_pxr IN LISTS PXR_INCLUDES)
    file(TO_CMAKE_PATH "${_pxr}" _pxr)
    foreach(_include IN LISTS CORE_INCLUDES)
        file(TO_CMAKE_PATH "${_include}" _include)
        if(_include STREQUAL _pxr)
            list(APPEND _failures "include directory ${_include}")
        endif()
    endforeach()
endforeach()
foreach(_link IN LISTS CORE_LINKS)
    if(_link IN_LIST PXR_TARGETS)
        list(APPEND _failures "target ${_link}")
    endif()
endforeach()
if(_failures)
    message(FATAL_ERROR "The core library depends on USD: ${_failures}")
endif()
list(LENGTH CORE_INCLUDES _includes)
list(LENGTH CORE_LINKS _links)
message(STATUS "core without USD: ${_includes} include directories, ${_links} linked targets, none from pxr")
