# Copy this file to cmake/PrismLocalDependencies.cmake and edit the roots for
# your machine. The copied file is ignored by git. CMake package discovery
# through CMAKE_PREFIX_PATH works without this file when dependencies are
# installed in standard locations.
set(pxr_DIR "$ENV{PRISM_OPENUSD_ROOT}" CACHE PATH "OpenUSD package config directory")
set(TBB_DIR "$ENV{PRISM_TBB_ROOT}/lib/cmake/tbb" CACHE PATH "oneTBB package config")
set(MaterialX_DIR "$ENV{PRISM_MATERIALX_ROOT}/lib/cmake/MaterialX" CACHE PATH "MaterialX package config")
set(embree_DIR "$ENV{PRISM_EMBREE_ROOT}/lib/cmake/embree-4.4.0" CACHE PATH "Embree package config")
set(OpenSubdiv_DIR "$ENV{PRISM_OPENSUBDIV_ROOT}/lib/cmake/OpenSubdiv" CACHE PATH "OpenSubdiv package config required by OpenUSD")
set(PRISM_EMBREE_RUNTIME_DIR "$ENV{PRISM_EMBREE_RUNTIME_DIR}" CACHE PATH "Embree runtime directory")
set(PRISM_EMBREE_BUILD_RUNTIME "$ENV{PRISM_EMBREE_BUILD_RUNTIME}" CACHE PATH "Additional Embree runtime directory")
set(MDL_SDK_DIR "$ENV{PRISM_MDL_SDK_ROOT}" CACHE PATH "Optional MDL SDK root")
set(PRISM_MATERIALX_LIBRARY_PATH "$ENV{PRISM_MATERIALX_ROOT}/libraries" CACHE PATH "MaterialX standard libraries")
set(PRISM_MATERIALX_MDL "$ENV{PRISM_MATERIALX_ROOT}/libraries/mdl" CACHE PATH "MaterialX MDL libraries")
set(CMAKE_PREFIX_PATH "$ENV{PRISM_VCPKG_PREFIX}" CACHE STRING "Additional package prefix paths")
set(OpenImageIO_DIR "$ENV{PRISM_OPENIMAGEIO_DIR}" CACHE PATH "OpenImageIO package config directory")
