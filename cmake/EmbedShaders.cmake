# Writes the shader sources below ROOT into a C++ table (OUTPUT), so devices
# find them without an installed shader directory.
#   cmake -DROOT=<shaders dir> -DOUTPUT=<file.cpp> -DHEADER=<shader_sources.h> -P EmbedShaders.cmake
file(GLOB_RECURSE _files RELATIVE "${ROOT}" "${ROOT}/*")
list(SORT _files)
set(_out "// Generated by cmake/EmbedShaders.cmake; do not edit.\n")
string(APPEND _out "#include \"${HEADER}\"\n\n")
string(APPEND _out "namespace prism::device::gpu {\nnamespace {\n")
set(_index 0)
set(_table "")
foreach(_file IN LISTS _files)
    file(READ "${ROOT}/${_file}" _content)
    string(LENGTH "${_content}" _length)
    # Literal pieces stay below the per-literal limits of every compiler.
    set(_chunks "")
    set(_offset 0)
    while(_offset LESS _length)
        string(SUBSTRING "${_content}" ${_offset} 8000 _piece)
        string(APPEND _chunks "    R\"prism_shader(${_piece})prism_shader\",\n")
        math(EXPR _offset "${_offset} + 8000")
    endwhile()
    if(_chunks STREQUAL "")
        set(_chunks "    \"\",\n")
    endif()
    string(APPEND _out "const char* const kChunks${_index}[] = {\n${_chunks}};\n")
    string(APPEND _table "    {\"${_file}\", kChunks${_index}, std::size(kChunks${_index})},\n")
    math(EXPR _index "${_index} + 1")
endforeach()
string(APPEND _out "} // namespace\n\nstd::span<const EmbeddedShader> EmbeddedShaders()\n{\n")
string(APPEND _out "    static const EmbeddedShader table[] = {\n${_table}    };\n    return table;\n}\n\n")
string(APPEND _out "} // namespace prism::device::gpu\n")
file(WRITE "${OUTPUT}.tmp" "${_out}")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
