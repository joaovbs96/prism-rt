#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1
)

# Foliage-like shadows: 40 overlapping alpha-cutout cards (a textured leaf
# mask on open_pbr geometry_opacity, with base colour, roughness and normal
# maps) in front of an opaque wall, lit by a small sphere light and a dim
# dome. Shadow rays to the wall cross cutouts in front of, or instead of, an
# opaque blocker (OpaqueOccluders, MDLMaterial::cutoutOpacity).
# Generated (positions from a fixed seed); textures in ./foliage.
