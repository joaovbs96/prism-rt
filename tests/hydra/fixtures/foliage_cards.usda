    def Scope "Looks"
    {
        def Material "Wall"
        {
            token outputs:mtlx:surface.connect = </World/Looks/Wall/Surface.outputs:out>

            def Shader "Surface"
            {
                uniform token info:id = "ND_open_pbr_surface_surfaceshader"
                color3f inputs:base_color = (0.8, 0.78, 0.75)
                float inputs:specular_weight = 0
                token outputs:out
            }
        }

        def Material "Leaf"
        {
            token outputs:mtlx:surface.connect = </World/Looks/Leaf/Surface.outputs:out>

            def Shader "Color"
            {
                uniform token info:id = "ND_image_color3"
                asset inputs:file = @./foliage/leaf_color.png@
                color3f outputs:out
            }

            def Shader "Mask"
            {
                uniform token info:id = "ND_image_float"
                asset inputs:file = @./foliage/leaf_mask.png@
                float outputs:out
            }

            def Shader "Roughness"
            {
                uniform token info:id = "ND_image_float"
                asset inputs:file = @../../obj/roughness.png@
                float outputs:out
            }

            def Shader "NormalImage"
            {
                uniform token info:id = "ND_image_vector3"
                asset inputs:file = @../../obj/normal.png@
                float3 outputs:out
            }

            def Shader "Normal"
            {
                uniform token info:id = "ND_normalmap_float"
                float3 inputs:in.connect = </World/Looks/Leaf/NormalImage.outputs:out>
                float3 outputs:out
            }

            def Shader "Surface"
            {
                uniform token info:id = "ND_open_pbr_surface_surfaceshader"
                color3f inputs:base_color.connect = </World/Looks/Leaf/Color.outputs:out>
                float inputs:specular_roughness.connect = </World/Looks/Leaf/Roughness.outputs:out>
                float inputs:geometry_opacity.connect = </World/Looks/Leaf/Mask.outputs:out>
                float3 inputs:geometry_normal.connect = </World/Looks/Leaf/Normal.outputs:out>
                bool inputs:geometry_thin_walled = 1
                token outputs:out
            }
        }
    }

    def SphereLight "Sun"
    {
        float inputs:radius = 0.25
        float inputs:intensity = 600
        double3 xformOp:translate = (2.5, 3, 6)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def DomeLight "Sky"
    {
        color3f inputs:color = (0.6, 0.7, 1)
        float inputs:intensity = 0.15
    }

    def Camera "Camera"
    {
        float focalLength = 30
        float horizontalAperture = 36
        float verticalAperture = 36
        float2 clippingRange = (0.1, 100)
        double3 xformOp:translate = (0, 0, 7)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
