#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

# GeomSubsets that overlap, where a later subset has no material (no binding,
# or one to a material that does not exist) on a mesh without a material of
# its own: such a subset leaves the faces as the earlier subsets assigned them
# (both loaders; the mesh's fallback grey where no subset has a material).
# Faces, left to right:
#   0: Red, then Missing  -> red
#   1: Red, then Unbound  -> red
#   2: Unbound            -> grey (fallback)
#   3: Blue               -> blue
# Overlapping bound subsets are left out: the loaders order them differently
# (docs/DECISIONS.md, 2026-10-28).
def Xform "World"
{
    def Camera "Camera"
    {
        float focalLength = 35
        float horizontalAperture = 36
        float verticalAperture = 24
        float2 clippingRange = (0.1, 100)
        double3 xformOp:translate = (0, 0, 7)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def DomeLight "Sky"
    {
        float inputs:intensity = 1
    }

    def Mesh "Strip"
    {
        uniform token subdivisionScheme = "none"
        int[] faceVertexCounts = [4, 4, 4, 4]
        int[] faceVertexIndices = [0, 1, 6, 5, 1, 2, 7, 6, 2, 3, 8, 7, 3, 4, 9, 8]
        point3f[] points = [(-4, -2, 0), (-2, -2, 0), (0, -2, 0), (2, -2, 0), (4, -2, 0), (-4, 2, 0), (-2, 2, 0), (0, 2, 0), (2, 2, 0), (4, 2, 0)]

        def GeomSubset "Red" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token elementType = "face"
            uniform token familyName = "materialBind"
            int[] indices = [0, 1]
            rel material:binding = </World/Looks/Red>
        }

        def GeomSubset "Missing" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token elementType = "face"
            uniform token familyName = "materialBind"
            int[] indices = [0]
            rel material:binding = </World/Looks/DoesNotExist>
        }

        def GeomSubset "Unbound"
        {
            uniform token elementType = "face"
            uniform token familyName = "materialBind"
            int[] indices = [1, 2]
        }

        def GeomSubset "Blue" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token elementType = "face"
            uniform token familyName = "materialBind"
            int[] indices = [3]
            rel material:binding = </World/Looks/Blue>
        }
    }

    def Scope "Looks"
    {
        def Material "Red"
        {
            token outputs:surface.connect = </World/Looks/Red/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.05, 0.05)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "Blue"
        {
            token outputs:surface.connect = </World/Looks/Blue/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.1, 0.8)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
    }
}
