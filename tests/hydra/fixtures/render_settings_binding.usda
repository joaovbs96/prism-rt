#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Preview"
)

# materialBindingPurposes: the panel's preview binding is green, its
# allPurpose binding red. /Render/Preview resolves preview first,
# /Render/AllPurpose only allPurpose bindings. Both carry prism:* settings.
def Xform "World"
{
    def Camera "Camera"
    {
        float focalLength = 35
        float horizontalAperture = 20
        float verticalAperture = 20
        float2 clippingRange = (0.1, 100)
        double3 xformOp:translate = (0, 0, 4)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Mesh "Panel" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        point3f[] points = [(-1,-1,0), (1,-1,0), (1,1,0), (-1,1,0)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0,1,2,3]
        normal3f[] normals = [(0,0,1)] (interpolation = "constant")
        uniform token subdivisionScheme = "none"
        rel material:binding = </World/Red>
        rel material:binding:preview = </World/Green>
    }

    def Material "Red"
    {
        token outputs:mtlx:surface.connect = </World/Red/Surface.outputs:out>
        def Shader "Surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 1
            color3f inputs:base_color = (0.8, 0.05, 0.05)
            float inputs:specular = 0
            token outputs:out
        }
    }

    def Material "Green"
    {
        token outputs:mtlx:surface.connect = </World/Green/Surface.outputs:out>
        def Shader "Surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 1
            color3f inputs:base_color = (0.05, 0.8, 0.05)
            float inputs:specular = 0
            token outputs:out
        }
    }

    def DomeLight "Environment"
    {
        color3f inputs:color = (1, 1, 1)
        float inputs:intensity = 1
    }
}

def Scope "Render"
{
    def RenderSettings "Preview"
    {
        rel camera = </World/Camera>
        uniform int2 resolution = (32, 32)
        uniform token[] materialBindingPurposes = ["preview", ""]
        int prism:samplesPerPixel = 4
        int prism:maxDepth = 2
    }

    def RenderSettings "AllPurpose"
    {
        rel camera = </World/Camera>
        uniform int2 resolution = (32, 32)
        uniform token[] materialBindingPurposes = [""]
        int prism:samplesPerPixel = 6
        int prism:maxDepth = 2
    }
}
