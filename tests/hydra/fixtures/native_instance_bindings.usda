#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
)

def Xform "World"
{
    def Camera "Camera"
    {
        float focalLength = 35
        float horizontalAperture = 36
        float verticalAperture = 20.25
        float2 clippingRange = (0.1, 100)
        double3 xformOp:translate = (0, 0, 6)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "Prototype" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        rel material:binding = </World/Gray>
        def Mesh "Panel"
        {
            point3f[] points = [(-0.8,-0.8,0), (0.8,-0.8,0), (0.8,0.8,0), (-0.8,0.8,0)]
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0,1,2,3]
            normal3f[] normals = [(0,0,1)] (interpolation = "constant")
            uniform token subdivisionScheme = "none"
        }
    }

    def Xform "Red" (
        instanceable = true
        prepend references = </World/Prototype>
        prepend apiSchemas = ["MaterialBindingAPI"]
    ) {
        double3 xformOp:translate = (-1.1, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </World/RedMaterial>
    }
    def Xform "Blue" (
        instanceable = true
        prepend references = </World/Prototype>
        prepend apiSchemas = ["MaterialBindingAPI"]
    ) {
        double3 xformOp:translate = (1.1, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </World/BlueMaterial>
    }

    def Material "Gray" {
        token outputs:surface.connect = </World/Gray/Shader.outputs:surface>
        def Shader "Shader" {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.4,0.4,0.4)
            float inputs:metallic = 0
            float inputs:roughness = 1
            token outputs:surface
        }
    }
    def Material "RedMaterial" {
        token outputs:surface.connect = </World/RedMaterial/Shader.outputs:surface>
        def Shader "Shader" {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.8,0.03,0.03)
            float inputs:metallic = 0
            float inputs:roughness = 1
            token outputs:surface
        }
    }
    def Material "BlueMaterial" {
        token outputs:surface.connect = </World/BlueMaterial/Shader.outputs:surface>
        def Shader "Shader" {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.03,0.08,0.8)
            float inputs:metallic = 0
            float inputs:roughness = 1
            token outputs:surface
        }
    }

    def DomeLight "Environment"
    {
        asset inputs:texture:file = @environment.ppm@
        float inputs:intensity = 2
    }
}
