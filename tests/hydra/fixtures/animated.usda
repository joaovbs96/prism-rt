#usda 1.0
(
    defaultPrim = "World"
    startTimeCode = 1
    endTimeCode = 2
    framesPerSecond = 24
    timeCodesPerSecond = 24
    upAxis = "Y"
    metersPerUnit = 1
)

def Xform "World"
{
    def Camera "Camera"
    {
        float focalLength = 50
        float horizontalAperture = 20.955
        float verticalAperture = 20.955
        float fStop = 0
        float focusDistance = 5
        float2 clippingRange = (0.1, 100)
        double3 xformOp:translate = (0, 0, 5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "Animated"
    {
        double3 xformOp:translate.timeSamples = {
            1: (-0.3, 0, 0),
            2: (0.3, 0, 0),
        }
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Mesh "Panel" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            point3f[] points.timeSamples = {
                1: [(-1, -1, 0), (1, -1, 0), (1, 1, 0), (-1, 1, 0)],
                2: [(-1, -0.7, 0), (1, -1, 0), (0.65, 1, 0), (-1, 0.7, 0)],
            }
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0, 1, 2, 3]
            normal3f[] normals = [(0, 0, 1)] (interpolation = "constant")
            texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (interpolation = "vertex")
            uniform token subdivisionScheme = "none"
            rel material:binding = </World/Looks/AnimatedMaterial>
        }
    }

    def Xform "VisibilityProbe"
    {
        double3 xformOp:translate = (1.3, 0.35, 0.1)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def Mesh "Patch"
        {
            point3f[] points = [(-0.2, -0.2, 0), (0.2, -0.2, 0), (0.2, 0.2, 0), (-0.2, 0.2, 0)]
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0, 1, 2, 3]
            uniform token subdivisionScheme = "none"
            token visibility.timeSamples = {
                1: "inherited",
                2: "invisible",
            }
            color3f[] primvars:displayColor = [(0.1, 0.8, 0.2)]
        }
    }

    def Scope "Looks"
    {
        def Material "AnimatedMaterial"
        {
            token outputs:surface.connect = </World/Looks/AnimatedMaterial/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.timeSamples = {
                    1: (0.9, 0.1, 0.05),
                    2: (0.05, 0.15, 0.9),
                }
                float inputs:roughness = 0.5
                float inputs:metallic = 0
                int inputs:useSpecularWorkflow = 1
                color3f inputs:specularColor = (0, 0, 0)
                token outputs:surface
            }
        }
    }

    def DomeLight "Environment"
    {
        uniform token info:implementationSource = "id"
        asset inputs:texture:file = @animated_environment.ppm@
        token inputs:texture:format = "latlong"
        color3f inputs:color = (1, 1, 1)
        float inputs:intensity = 1
        float inputs:exposure = 0
        double3 xformOp:rotateXYZ.timeSamples = {
            1: (0, 0, 0),
            2: (0, 90, 0),
        }
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }
}
