#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1
)

# Load-time displacement (docs/hydra.md, "Subdivision surfaces and
# displacement"): a polygon card whose MaterialX displacement raises sine
# ridges along its texture coordinates, diced bilinearly to the displacement
# level; and a Catmull-Clark cube, refined to the subdivision level, beside it.
def Xform "World"
{
    def Camera "Camera"
    {
        float focalLength = 35
        float horizontalAperture = 36
        float verticalAperture = 24
        float2 clippingRange = (0.1, 100)
        double3 xformOp:translate = (0, 1.6, 4.5)
        float3 xformOp:rotateXYZ = (-20, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def Mesh "Card" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token subdivisionScheme = "none"
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-1.5, 0, 1), (0.5, 0, 1), (0.5, 0, -1), (-1.5, 0, -1)]
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (interpolation = "vertex")
        rel material:binding = </World/Looks/Ridges>
    }

    def Mesh "Cube"
    {
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 1, 3, 2, 2, 3, 5, 4, 4, 5, 7, 6, 6, 7, 1, 0, 1, 7, 5, 3, 6, 0, 2, 4]
        point3f[] points = [(-0.4, -0.4, 0.4), (0.4, -0.4, 0.4), (-0.4, 0.4, 0.4), (0.4, 0.4, 0.4), (-0.4, 0.4, -0.4), (0.4, 0.4, -0.4), (-0.4, -0.4, -0.4), (0.4, -0.4, -0.4)]
        uniform token subdivisionScheme = "catmullClark"
        color3f[] primvars:displayColor = [(0.2, 0.4, 0.8)]
        double3 xformOp:translate = (1.2, 0.5, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Scope "Looks"
    {
        def Material "Ridges"
        {
            token outputs:mtlx:surface.connect = </World/Looks/Ridges/Surface.outputs:out>
            token outputs:mtlx:displacement.connect = </World/Looks/Ridges/Displace.outputs:out>

            def Shader "Surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                float inputs:base = 1
                color3f inputs:base_color = (0.75, 0.6, 0.4)
                float inputs:specular = 0
                token outputs:out
            }

            def Shader "Coordinates"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "U"
            {
                uniform token info:id = "ND_extract_vector2"
                float2 inputs:in.connect = </World/Looks/Ridges/Coordinates.outputs:out>
                int inputs:index = 0
                float outputs:out
            }

            def Shader "Scaled"
            {
                uniform token info:id = "ND_multiply_float"
                float inputs:in1.connect = </World/Looks/Ridges/U.outputs:out>
                float inputs:in2 = 25
                float outputs:out
            }

            def Shader "Sine"
            {
                uniform token info:id = "ND_sin_float"
                float inputs:in.connect = </World/Looks/Ridges/Scaled.outputs:out>
                float outputs:out
            }

            def Shader "Displace"
            {
                uniform token info:id = "ND_displacement_float"
                float inputs:displacement.connect = </World/Looks/Ridges/Sine.outputs:out>
                float inputs:scale = 0.12
                token outputs:out
            }
        }
    }

    def DomeLight "Dome"
    {
        asset inputs:texture:file = @environment.ppm@
        float inputs:intensity = 1
    }
}
