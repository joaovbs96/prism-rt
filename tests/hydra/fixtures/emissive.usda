#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
)

def Xform "World"
{
    def Mesh "Floor"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-3, 0, 3), (3, 0, 3), (3, 0, -3), (-3, 0, -3)]
        color3f[] primvars:displayColor = [(0.7, 0.7, 0.7)]
    }

    def Mesh "Back"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-3, 0, -2), (3, 0, -2), (3, 3, -2), (-3, 3, -2)]
        color3f[] primvars:displayColor = [(0.5, 0.6, 0.5)]
    }

    def Sphere "Ball"
    {
        double radius = 0.5
        double3 xformOp:translate = (0.3, 0.5, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.3, 0.4, 0.8)]
    }

    def Mesh "Panel" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4, 4]
        int[] faceVertexIndices = [0, 1, 2, 3, 3, 2, 4, 5]
        point3f[] points = [(-0.6, 2.4, -0.4), (0.6, 2.4, -0.4), (0.6, 2.4, 0.4), (-0.6, 2.4, 0.4), (0.6, 2.0, 1.0), (-0.6, 2.0, 1.0)]
        double3 xformOp:translate = (-0.5, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </World/Looks/Light>
    }

    def Scope "Looks"
    {
        def Material "Light"
        {
            token outputs:surface.connect = </World/Looks/Light/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0, 0, 0)
                color3f inputs:emissiveColor = (6, 5, 4)
                token outputs:surface
            }
        }
    }

    def Camera "Camera"
    {
        float focalLength = 28
        float horizontalAperture = 36
        float verticalAperture = 24
        double3 xformOp:translate = (0, 1.4, 5)
        float3 xformOp:rotateXYZ = (-6, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
}
