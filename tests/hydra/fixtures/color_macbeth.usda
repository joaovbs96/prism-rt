    def Camera "Camera"
    {
        token projection = "orthographic"
        float horizontalAperture = 120
        float verticalAperture = 80
        float2 clippingRange = (0.1, 100)
        double3 xformOp:translate = (0, 0, 5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
