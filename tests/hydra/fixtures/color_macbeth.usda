#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
)

# Colour for stock Hydra hosts (docs/color_management.md, "Output space"): the
# 24 ColorChecker patches (sRGB 8-bit values tagged srgb_texture) as diffuse
# standard_surface patches seen straight on, lit by a constant white dome.
# A host that applies only the sRGB transfer to the delegate's colour AOV
# (stock HdxColorCorrectionTask in sRGB mode, no Prism settings) must show
# the image the CLI renders with --working-space lin_rec709.
def Xform "World"
{
    def Mesh "DarkSkin" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-5.8, 2.2, 0), (-4.2, 2.2, 0), (-4.2, 3.8, 0), (-5.8, 3.8, 0)]
        rel material:binding = </World/Looks/DarkSkin>
    }

    def Mesh "LightSkin" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-3.8, 2.2, 0), (-2.2, 2.2, 0), (-2.2, 3.8, 0), (-3.8, 3.8, 0)]
        rel material:binding = </World/Looks/LightSkin>
    }

