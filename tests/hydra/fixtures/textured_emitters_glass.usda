#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1
)

# Several textured emitters next to rough glass (the GPU program budget
# tests, docs/gpu_devices.md): three emitters of varying emission, each its
# own MDL program, light a diffuse floor and a block of partly transmissive,
# rough OpenPBR glass, whose program is the largest (like the OpenPBR
# playground's tape, about 3.5 times the SPIR-V of an opaque OpenPBR
# material). The scene has no other lights.
def Xform "World"
{
    def Mesh "Floor" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-3, 0, 3), (3, 0, 3), (3, 0, -3), (-3, 0, -3)]
        uniform token subdivisionScheme = "none"
        rel material:binding = </World/Looks/Floor>
    }

    def Mesh "Glass" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [1, 2, 3, 0, 7, 6, 5, 4, 4, 5, 1, 0, 5, 6, 2, 1, 6, 7, 3, 2, 7, 4, 0, 3]
        point3f[] points = [(-0.4, 0, -0.4), (0.4, 0, -0.4), (0.4, 0, 0.4), (-0.4, 0, 0.4), (-0.4, 0.8, -0.4), (0.4, 0.8, -0.4), (0.4, 0.8, 0.4), (-0.4, 0.8, 0.4)]
        uniform token subdivisionScheme = "none"
        double3 xformOp:translate = (0, 0, 0.6)
        float3 xformOp:rotateXYZ = (0, 30, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        rel material:binding = </World/Looks/RoughGlass>
    }

    def Mesh "EmitterA" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4, 4, 4, 4]
        int[] faceVertexIndices = [0, 1, 4, 3, 1, 2, 5, 4, 3, 4, 7, 6, 4, 5, 8, 7]
        point3f[] points = [(-0.5, 0, -0.5), (0, 0, -0.5), (0.5, 0, -0.5), (-0.5, 0, 0), (0, 0, 0), (0.5, 0, 0), (-0.5, 0, 0.5), (0, 0, 0.5), (0.5, 0, 0.5)]
        texCoord2f[] primvars:st = [(0, 0), (0.5, 0), (1, 0), (0, 0.5), (0.5, 0.5), (1, 0.5), (0, 1), (0.5, 1), (1, 1)] (
            interpolation = "vertex"
        )
        uniform token subdivisionScheme = "none"
        double3 xformOp:translate = (-1.4, 1.6, -0.6)
        float3 xformOp:rotateXYZ = (-35, 0, -25)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        rel material:binding = </World/Looks/CheckerEmission>
    }

    def Mesh "EmitterB" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4, 4, 4, 4]
        int[] faceVertexIndices = [0, 1, 4, 3, 1, 2, 5, 4, 3, 4, 7, 6, 4, 5, 8, 7]
        point3f[] points = [(-0.5, 0, -0.5), (0, 0, -0.5), (0.5, 0, -0.5), (-0.5, 0, 0), (0, 0, 0), (0.5, 0, 0), (-0.5, 0, 0.5), (0, 0, 0.5), (0.5, 0, 0.5)]
        texCoord2f[] primvars:st = [(0, 0), (0.5, 0), (1, 0), (0, 0.5), (0.5, 0.5), (1, 0.5), (0, 1), (0.5, 1), (1, 1)] (
            interpolation = "vertex"
        )
        uniform token subdivisionScheme = "none"
        double3 xformOp:translate = (0, 1.8, -1)
        float3 xformOp:rotateXYZ = (-45, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        rel material:binding = </World/Looks/OpenPbrEmission>
    }

    def Mesh "EmitterC" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4, 4, 4, 4]
        int[] faceVertexIndices = [0, 1, 4, 3, 1, 2, 5, 4, 3, 4, 7, 6, 4, 5, 8, 7]
        point3f[] points = [(-0.5, 0, -0.5), (0, 0, -0.5), (0.5, 0, -0.5), (-0.5, 0, 0), (0, 0, 0), (0.5, 0, 0), (-0.5, 0, 0.5), (0, 0, 0.5), (0.5, 0, 0.5)]
        texCoord2f[] primvars:st = [(0, 0), (0.5, 0), (1, 0), (0, 0.5), (0.5, 0.5), (1, 0.5), (0, 1), (0.5, 1), (1, 1)] (
            interpolation = "vertex"
        )
        uniform token subdivisionScheme = "none"
        double3 xformOp:translate = (1.4, 1.6, -0.6)
        float3 xformOp:rotateXYZ = (-35, 0, 25)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        rel material:binding = </World/Looks/TintedEmission>
    }

    def Scope "Looks"
    {
        def Material "Floor"
        {
            token outputs:mtlx:surface.connect = </World/Looks/Floor/Surface.outputs:out>

            def Shader "Surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                float inputs:base = 1
                color3f inputs:base_color = (0.8, 0.8, 0.8)
                float inputs:specular = 0
                token outputs:out
            }
        }

        def Material "RoughGlass"
        {
            token outputs:mtlx:surface.connect = </World/Looks/RoughGlass/Surface.outputs:out>

            def Shader "Surface"
            {
                uniform token info:id = "ND_open_pbr_surface_surfaceshader"
                float inputs:specular_roughness = 0.3
                float inputs:transmission_weight = 0.75
                color3f inputs:transmission_color = (0.85, 0.95, 0.9)
                token outputs:out
            }
        }

        def Material "CheckerEmission"
        {
            token outputs:mtlx:surface.connect = </World/Looks/CheckerEmission/Surface.outputs:out>

            def Shader "Image"
            {
                uniform token info:id = "ND_image_color3"
                asset inputs:file = @./textured_emitter_checker.ppm@ (
                    colorSpace = "lin_rec709"
                )
                color3f outputs:out
            }

            def Shader "Surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                float inputs:base = 0
                float inputs:specular = 0
                float inputs:emission = 12
                color3f inputs:emission_color.connect = </World/Looks/CheckerEmission/Image.outputs:out>
                token outputs:out
            }
        }

        def Material "OpenPbrEmission"
        {
            token outputs:mtlx:surface.connect = </World/Looks/OpenPbrEmission/Surface.outputs:out>

            def Shader "Image"
            {
                uniform token info:id = "ND_image_color3"
                asset inputs:file = @./textured_emitter_checker.ppm@ (
                    colorSpace = "lin_rec709"
                )
                color3f outputs:out
            }

            def Shader "Surface"
            {
                uniform token info:id = "ND_open_pbr_surface_surfaceshader"
                float inputs:base_weight = 0.2
                float inputs:specular_weight = 0
                float inputs:emission_luminance = 12
                color3f inputs:emission_color.connect = </World/Looks/OpenPbrEmission/Image.outputs:out>
                token outputs:out
            }
        }

        def Material "TintedEmission"
        {
            token outputs:mtlx:surface.connect = </World/Looks/TintedEmission/Surface.outputs:out>

            def Shader "Image"
            {
                uniform token info:id = "ND_image_color3"
                asset inputs:file = @./textured_emitter_checker.ppm@ (
                    colorSpace = "lin_rec709"
                )
                color3f outputs:out
            }

            def Shader "Tint"
            {
                uniform token info:id = "ND_multiply_color3"
                color3f inputs:in1.connect = </World/Looks/TintedEmission/Image.outputs:out>
                color3f inputs:in2 = (1, 0.6, 0.3)
                color3f outputs:out
            }

            def Shader "Surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                float inputs:base = 0
                float inputs:specular = 0
                float inputs:emission = 15
                color3f inputs:emission_color.connect = </World/Looks/TintedEmission/Tint.outputs:out>
                token outputs:out
            }
        }
    }

    def Camera "Camera"
    {
        float focalLength = 24
        float horizontalAperture = 36
        float verticalAperture = 36
        float2 clippingRange = (0.1, 100)
        double3 xformOp:translate = (0, 1.3, 4.2)
        float3 xformOp:rotateXYZ = (-14, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
}
