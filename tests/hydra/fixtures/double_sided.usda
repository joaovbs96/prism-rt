#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
)

# prism:honorDoubleSided: red cards in front of a blue backdrop, left to right:
#   single-sided, facing away      -> culled (the backdrop shows)
#   doubleSided, facing away       -> drawn
#   single-sided, facing the camera -> drawn
#   single-sided glass, facing away -> drawn (transmissive materials are never culled)
#   single-sided, facing the camera but mirrored (scale -1 in x) -> culled
#     (the mirror reverses its winding, as front_face sees it)
def Scope "Render"
{
    def RenderSettings "Settings"
    {
        rel camera = </World/Camera>
        uniform int2 resolution = (64, 64)
        bool prism:honorDoubleSided = 1
    }
}

def Xform "World"
{
    def Camera "Camera"
    {
        float focalLength = 35
        float horizontalAperture = 20
        float verticalAperture = 20
        float2 clippingRange = (0.1, 100)
        double3 xformOp:translate = (0, 0, 4)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Mesh "Backdrop"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-3, -3, -1), (3, -3, -1), (3, 3, -1), (-3, 3, -1)]
        color3f[] primvars:displayColor = [(0.1, 0.1, 0.8)]
        uniform token subdivisionScheme = "none"
    }

    def Mesh "SingleAway"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-1.08, -0.4, 0), (-1.08, 0.4, 0), (-0.72, 0.4, 0), (-0.72, -0.4, 0)]
        color3f[] primvars:displayColor = [(0.8, 0.1, 0.1)]
        uniform token subdivisionScheme = "none"
    }

    def Mesh "DoubleAway"
    {
        uniform bool doubleSided = 1
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-0.63, -0.4, 0), (-0.63, 0.4, 0), (-0.27, 0.4, 0), (-0.27, -0.4, 0)]
        color3f[] primvars:displayColor = [(0.8, 0.1, 0.1)]
        uniform token subdivisionScheme = "none"
    }

    def Mesh "SingleFacing"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-0.18, -0.4, 0), (0.18, -0.4, 0), (0.18, 0.4, 0), (-0.18, 0.4, 0)]
        color3f[] primvars:displayColor = [(0.8, 0.1, 0.1)]
        uniform token subdivisionScheme = "none"
    }

    def Mesh "GlassAway" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(0.27, -0.4, 0), (0.27, 0.4, 0), (0.63, 0.4, 0), (0.63, -0.4, 0)]
        uniform token subdivisionScheme = "none"
        rel material:binding = </World/Glass>
    }

    def Mesh "MirroredFacing"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-0.18, -0.4, 0), (0.18, -0.4, 0), (0.18, 0.4, 0), (-0.18, 0.4, 0)]
        color3f[] primvars:displayColor = [(0.8, 0.1, 0.1)]
        uniform token subdivisionScheme = "none"
        double3 xformOp:translate = (0.9, 0, 0)
        double3 xformOp:scale = (-1, 1, 1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Material "Glass"
    {
        token outputs:mtlx:surface.connect = </World/Glass/Surface.outputs:out>
        def Shader "Surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 0
            float inputs:specular = 1
            float inputs:specular_roughness = 0
            float inputs:transmission = 1
            color3f inputs:transmission_color = (0.2, 0.9, 0.2)
            bool inputs:thin_walled = 1
            token outputs:out
        }
    }

    def DomeLight "Dome"
    {
        float inputs:intensity = 1
    }
}
