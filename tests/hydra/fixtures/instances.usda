#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1
)

def Xform "World"
{
    def Camera "Camera"
    {
        float focalLength = 35
        float horizontalAperture = 36
        float verticalAperture = 20.25
        float fStop = 0
        float focusDistance = 10
        float2 clippingRange = (0.1, 100)
        double3 xformOp:translate = (0, 0, 10)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def PointInstancer "MainInstancer"
    {
        float3[] extent = [(-2.65,-0.7,-0.65), (2.55,0.7,0.65)]
        point3f[] positions = [(-2,0,0), (0,0,0), (2,0,0)]
        int[] protoIndices = [0,1,0]
        int64[] ids = [101,202,303]
        float3[] scales = [(-1.3,0.75,1), (0.75,1.4,1), (1.1,0.65,1.3)]
        quatf[] orientationsf = [(1,0,0,0), (1,0,0,0), (1,0,0,0)]
        rel prototypes = [
            </World/MainInstancer/Prototypes/Red>,
            </World/MainInstancer/Prototypes/Blue>,
        ]

        def "Prototypes"
        {
            def Xform "Red" {
                token visibility = "inherited"
                def Cube "Shape" {
                    float size = 1
                    color3f[] primvars:displayColor = [(0.9,0.08,0.05)]
                }
            }
            def Xform "Blue" {
                token visibility = "inherited"
                def Cube "Shape" {
                    float size = 1
                    color3f[] primvars:displayColor = [(0.05,0.2,0.95)]
                }
            }
        }
    }

    # The outer point instance contains another point instancer in its
    # prototype hierarchy, exercising nested source and flattened indices.
    def PointInstancer "NestedOuter"
    {
        float3[] extent = [(-0.86,2.06,-0.84), (0.86,2.84,-0.16)]
        point3f[] positions = [(0,2.45,-0.5)]
        int[] protoIndices = [0]
        int64[] ids = [707]
        float3[] scales = [(1,1,1)]
        quatf[] orientationsf = [(1,0,0,0)]
        rel prototypes = [</World/NestedOuter/Prototypes/OuterPrototype>]

        def "Prototypes"
        {
            def Xform "OuterPrototype"
            {
                def PointInstancer "Inner"
                {
                    float3[] extent = [(-0.86,-0.39,-0.33), (0.86,0.39,0.33)]
                    point3f[] positions = [(-0.55,0,0), (0.55,0,0)]
                    int[] protoIndices = [0,0]
                    int64[] ids = [801,802]
                    float3[] scales = [(0.8,1.4,0.7), (-1.1,0.75,1.2)]
                    quatf[] orientationsf = [(1,0,0,0), (1,0,0,0)]
                    rel prototypes = [</World/NestedOuter/Prototypes/InnerPrototype>]
                }
            }
            def Xform "InnerPrototype"
            {
                token visibility = "inherited"
                def Cube "Shape"
                {
                    float size = 0.55
                    color3f[] primvars:displayColor = [(0.1,0.85,0.25)]
                }
            }
        }
    }

    def DomeLight "Environment"
    {
        asset inputs:texture:file = @../../../assets/environment/IndoorEnvironmentHDRI003_4K-HDR.exr@
        token inputs:texture:format = "latlong"
        color3f inputs:color = (1,1,1)
        float inputs:intensity = 1
        float inputs:exposure = 0
    }
}
