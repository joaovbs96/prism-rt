#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1
)

# A closed box of thin-walled, tinted OpenPBR glass on a floor, under a dome
# and a sphere light (docs/materialx_compatibility.md, "Thin-walled
# open_pbr_surface"). Rays inside the box hit its walls from behind, where the
# material scatters with its backface: the surface's own BSDF, which the CPU
# and GPU backends compile once (the backface uses the surface's function).
def Xform "World"
{
    def Mesh "Floor" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-3, 0, 3), (3, 0, 3), (3, 0, -3), (-3, 0, -3)]
        uniform token subdivisionScheme = "none"
        rel material:binding = </World/Looks/Floor>
    }

    def Mesh "Box" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [1, 2, 3, 0, 7, 6, 5, 4, 4, 5, 1, 0, 5, 6, 2, 1, 6, 7, 3, 2, 7, 4, 0, 3]
        point3f[] points = [(-0.5, 0.01, -0.5), (0.5, 0.01, -0.5), (0.5, 0.01, 0.5), (-0.5, 0.01, 0.5), (-0.5, 1, -0.5), (0.5, 1, -0.5), (0.5, 1, 0.5), (-0.5, 1, 0.5)]
        uniform token subdivisionScheme = "none"
        double3 xformOp:translate = (0, 0, 0.4)
        float3 xformOp:rotateXYZ = (0, 30, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        rel material:binding = </World/Looks/ThinGlass>
    }

    def Sphere "Ball" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.25
        double3 xformOp:translate = (0, 0.26, 0.4)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </World/Looks/Floor>
    }

    def Scope "Looks"
    {
        def Material "Floor"
        {
            token outputs:mtlx:surface.connect = </World/Looks/Floor/Surface.outputs:out>

            def Shader "Surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                float inputs:base = 1
                color3f inputs:base_color = (0.8, 0.6, 0.4)
                float inputs:specular = 0
                token outputs:out
            }
        }

        def Material "ThinGlass"
        {
            token outputs:mtlx:surface.connect = </World/Looks/ThinGlass/Surface.outputs:out>

            def Shader "Surface"
            {
                uniform token info:id = "ND_open_pbr_surface_surfaceshader"
                bool inputs:geometry_thin_walled = 1
                float inputs:specular_roughness = 0.15
                float inputs:transmission_weight = 1
                color3f inputs:transmission_color = (0.6, 0.9, 0.7)
                token outputs:out
            }
        }
    }

    def DomeLight "Dome"
    {
        color3f inputs:color = (0.6, 0.7, 0.9)
        float inputs:intensity = 1
    }

    def SphereLight "Key"
    {
        float inputs:radius = 0.3
        float inputs:intensity = 40
        double3 xformOp:translate = (1.5, 2.5, 1.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Camera "Camera"
    {
        float focalLength = 24
        float horizontalAperture = 36
        float verticalAperture = 36
        float2 clippingRange = (0.1, 100)
        double3 xformOp:translate = (0, 1.4, 3.2)
        float3 xformOp:rotateXYZ = (-18, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
}
