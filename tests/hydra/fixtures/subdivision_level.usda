#usda 1.0
(
    defaultPrim = "World"
    renderSettingsPrimPath = "/Render/Hull"
    upAxis = "Y"
)

# prism:subdivisionLevel from the render settings (Hydra; the standalone
# loader has no subdivision surfaces yet): a Catmull-Clark cube (6 quads)
# renders as its control hull (12 triangles) under /Render/Hull and refined
# at the default level 2 (192 triangles) under /Render/Default.
def Xform "World"
{
    def Mesh "Cube"
    {
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 1, 3, 2, 2, 3, 5, 4, 4, 5, 7, 6, 6, 7, 1, 0, 1, 7, 5, 3, 6, 0, 2, 4]
        point3f[] points = [(-0.5, -0.5, 0.5), (0.5, -0.5, 0.5), (-0.5, 0.5, 0.5), (0.5, 0.5, 0.5), (-0.5, 0.5, -0.5), (0.5, 0.5, -0.5), (-0.5, -0.5, -0.5), (0.5, -0.5, -0.5)]
        uniform token subdivisionScheme = "catmullClark"
    }

    def DomeLight "Dome"
    {
        float inputs:intensity = 1
    }

    def Camera "Camera"
    {
        double3 xformOp:translate = (0, 0, 4)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

def Scope "Render"
{
    def RenderSettings "Hull"
    {
        rel camera = </World/Camera>
        int2 resolution = (32, 32)
        int prism:subdivisionLevel = 0
    }

    def RenderSettings "Default"
    {
        rel camera = </World/Camera>
        int2 resolution = (32, 32)
    }
}