#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1
)

# A constant dome tinted by its colour temperature (3000 K: orange). The
# camera sees the dome around a small grey sphere it lights.
def Xform "World"
{
    def Camera "Camera"
    {
        float focalLength = 35
        float horizontalAperture = 20
        float verticalAperture = 20
        float2 clippingRange = (0.1, 100)
        double3 xformOp:translate = (0, 0, 4)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Sphere "Ball"
    {
        double radius = 0.4
        color3f[] primvars:displayColor = [(0.7, 0.7, 0.7)]
    }

    def DomeLight "Dome"
    {
        float inputs:intensity = 1
        bool inputs:enableColorTemperature = 1
        float inputs:colorTemperature = 3000
    }
}
