#usda 1.0
(
    defaultPrim = "World"
    startTimeCode = 1
    endTimeCode = 2
    framesPerSecond = 24
    timeCodesPerSecond = 24
    upAxis = "Y"
    metersPerUnit = 1
)

def Xform "World"
{
    def Camera "Camera"
    {
        float focalLength = 50
        float horizontalAperture = 20.955
        float verticalAperture = 20.955
        float fStop = 0
        float focusDistance = 5
        float2 clippingRange = (0.1, 100)
        double3 xformOp:translate = (0, 0, 5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Mesh "Panel"
    {
        point3f[] points = [(-0.45, -0.45, 0), (0.45, -0.45, 0), (0.45, 0.45, 0), (-0.45, 0.45, 0)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        normal3f[] normals = [(0, 0, 1)] (interpolation = "constant")
        uniform token subdivisionScheme = "none"
        color3f[] primvars:displayColor = [(0.8, 0.2, 0.1)]
        double3 xformOp:translate.timeSamples = {
            1: (-0.8, 0, 0),
            2: (0.8, 0, 0),
        }
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def DomeLight "Environment"
    {
        uniform token info:implementationSource = "id"
        color3f inputs:color = (1, 1, 1)
        float inputs:intensity = 1
        float inputs:exposure = 0
    }
}
