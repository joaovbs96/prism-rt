#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1
)

# prism_hydra_host_contract_test: a triangle (slanted edges, so edge pixels
# are partly covered) in front of a constant dome. The host hides the dome
# from the camera, so everything around the triangle is background.
def Xform "World"
{
    def Camera "Camera"
    {
        float focalLength = 35
        float horizontalAperture = 20
        float verticalAperture = 20
        float2 clippingRange = (0.1, 100)
        double3 xformOp:translate = (0, 0, 4)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Mesh "Triangle"
    {
        point3f[] points = [(-0.9,-0.7,0), (0.85,-0.55,0), (0.1,0.9,0)]
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0,1,2]
        normal3f[] normals = [(0,0,1)] (interpolation = "constant")
        color3f[] primvars:displayColor = [(0.6,0.4,0.2)]
        uniform token subdivisionScheme = "none"
    }

    def DomeLight "Environment"
    {
        color3f inputs:color = (1,1,1)
        float inputs:intensity = 1
    }
}
