#usda 1.0
(
    defaultPrim = "World"
    renderSettingsPrimPath = "/Render/Settings"
    upAxis = "Y"
)

# The albedo AOV through delta bounces (docs/hydra.md, "Light AOVs"): inside
# a room of one diffuse colour, a smooth glass sphere and a mirror sphere
# show the walls' colour in the albedo (every refracted and reflected path
# ends on a wall), a diffuse sphere its own colour.
def Scope "Render"
{
    def RenderSettings "Settings"
    {
        rel camera = </World/Camera>
        uniform int2 resolution = (96, 64)
        rel products = [</Render/Products/Albedo>]
        int prism:samplesPerPixel = 64
        int prism:maxDepth = 16
    }

    def Scope "Products"
    {
        def RenderProduct "Albedo"
        {
            uniform token productName = "light_aovs_albedo.exr"
            rel orderedVars = [</Render/Vars/Color>, </Render/Vars/Albedo>]
        }
    }

    def Scope "Vars"
    {
        def RenderVar "Color"
        {
            uniform token dataType = "color3f"
            uniform string sourceName = "color"
        }

        def RenderVar "Albedo"
        {
            uniform token dataType = "color3f"
            uniform string sourceName = "albedo"
        }
    }
}

def Xform "World"
{
    # The room: a closed box of six quads around the camera.
    def Mesh "Room"
    {
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 1, 2, 3, 4, 7, 6, 5, 0, 4, 5, 1, 3, 2, 6, 7, 0, 3, 7, 4, 1, 5, 6, 2]
        point3f[] points = [(-4, -2, -4), (4, -2, -4), (4, 4, -4), (-4, 4, -4),
                            (-4, -2, 6), (4, -2, 6), (4, 4, 6), (-4, 4, 6)]
        color3f[] primvars:displayColor = [(0.7, 0.35, 0.15)]
    }

    def Sphere "Glass" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.6
        double3 xformOp:translate = (-1.5, 0, -1)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </World/Looks/Glass>
    }

    def Sphere "Diffuse"
    {
        double radius = 0.6
        double3 xformOp:translate = (0, 0, -1)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.2, 0.6, 0.3)]
    }

    def Sphere "Mirror" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.6
        double3 xformOp:translate = (1.5, 0, -1)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </World/Looks/Mirror>
    }

    def SphereLight "Light"
    {
        float radius = 0.3
        float inputs:intensity = 30
        double3 xformOp:translate = (0, 3, 1)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Scope "Looks"
    {
        def Material "Glass"
        {
            token outputs:mtlx:surface.connect = </World/Looks/Glass/Surface.outputs:out>

            def Shader "Surface"
            {
                uniform token info:id = "ND_open_pbr_surface_surfaceshader"
                float inputs:base_weight = 0
                float inputs:specular_roughness = 0
                float inputs:specular_ior = 1.5
                float inputs:transmission_weight = 1
                token outputs:out
            }
        }

        def Material "Mirror"
        {
            token outputs:mtlx:surface.connect = </World/Looks/Mirror/Surface.outputs:out>

            def Shader "Surface"
            {
                uniform token info:id = "ND_open_pbr_surface_surfaceshader"
                float inputs:base_metalness = 1
                color3f inputs:base_color = (1, 1, 1)
                float inputs:specular_roughness = 0
                token outputs:out
            }
        }
    }

    def Camera "Camera"
    {
        float focalLength = 35
        float horizontalAperture = 36
        float verticalAperture = 24
        float2 clippingRange = (0.1, 100)
        double3 xformOp:translate = (0, 0, 3)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
