<?xml version="1.0"?>
<!-- Two materials in one document: the material preview takes the first
     ("red") unless --material-name / material_name names another. -->
<materialx version="1.39" colorspace="lin_rec709">
  <standard_surface name="SR_red" type="surfaceshader">
    <input name="base_color" type="color3" value="0.8, 0.05, 0.05" />
    <input name="specular_roughness" type="float" value="0.3" />
  </standard_surface>
  <surfacematerial name="red" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_red" />
  </surfacematerial>
  <standard_surface name="SR_blue" type="surfaceshader">
    <input name="base_color" type="color3" value="0.05, 0.1, 0.8" />
    <input name="specular_roughness" type="float" value="0.3" />
  </standard_surface>
  <surfacematerial name="blue" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_blue" />
  </surfacematerial>
</materialx>
