#usda 1.0
(
    defaultPrim = "standard_shader_ball_scene"
    metersPerUnit = 0.01
    upAxis = "Y"
    subLayers = [
        @./shaderball/standard_shader_ball_scene.usda@
    ]
)

# The material preview's stage (docs/material_preview.md): the USD-WG
# StandardShaderBall, unchanged, with the asset's own materials set to its
# "standard_surface" material_model variant. The asset's default in the file,
# "OpenPBRSurface", leaves the neutral material (the ball's core and base)
# without its base_color texture, so those render at OpenPBR's default 0.8
# instead of the mid-grey neutral map. This layer is the only place the
# selection is made: MaterialPreviewScene() opens it and the parity fixture
# sublayers it.
over "standard_shader_ball_scene"
{
    over "materials" (
        variants = {
            string material_model = "standard_surface"
        }
    )
    {
        over "examples" (
            variants = {
                string material_model = "standard_surface"
            }
        )
        {
        }

        over "box_base" (
            variants = {
                string material_model = "standard_surface"
            }
        )
        {
        }
    }
}
